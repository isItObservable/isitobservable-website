---
import { Image } from 'astro:assets';
import { formatDate, imageFile } from '~/lib/content';

interface Props { name: string; image?: string; date: Date; readingTime: string }
const { name, image, date, readingTime } = Astro.props;
---
<div class="author">
  {image && <Image src={imageFile(image)} alt={name} width={112} />}
  <div>
    <p><strong>{name}</strong></p>
    <p class="muted">{formatDate(date)}</p>
    <p class="muted">{readingTime} read</p>
  </div>
</div>

<style>
  .author { display: flex; align-items: flex-start; }
  .author :global(img) { width: 3.5rem; height: auto; margin-right: 1rem; border-radius: 1.5rem; }
  p { margin: 0; font-size: var(--step-m1); }
  .muted { opacity: 0.5; }
</style>
