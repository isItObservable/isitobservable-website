---
// Horizontal row of cards that bleeds past the container on the right. Native scroll-snap;
// the arrow buttons scroll by one card (~/scripts/row.ts).
import ArrowRight from '~/icons/arrow-right-blue.svg';
import ArrowSlider from '~/icons/arrow-slider.svg';
import Card from './Card.astro';
import type { Entry } from '~/lib/content';

interface Props { title: string; link?: string; entries: Entry[] }
const { title, link, entries } = Astro.props;
---
<section class="row" data-row>
  <div class="container head">
    <h3>{title}</h3>
    {link && <a class="all" href={link}>View all<ArrowRight aria-hidden="true" /></a>}
  </div>
  <div class="track">
    <ul class="scroller" data-row-scroller>
      {entries.map((entry) => <li><Card entry={entry} variant="row" /></li>)}
    </ul>
    <button class="nav prev" aria-label="Previous articles" data-row-prev><ArrowSlider aria-hidden="true" /></button>
    <button class="nav next" aria-label="Next articles" data-row-next><ArrowSlider aria-hidden="true" /></button>
  </div>
</section>

<script>
  import '~/scripts/row.ts';
</script>

<style>
  .head { display: flex; justify-content: space-between; }
  h3 { font-size: var(--step-2); }
  .all { display: flex; align-items: center; gap: 0.5rem; color: var(--primary); font-weight: 500; white-space: nowrap; }
  .all :global(svg) { transition: transform 0.2s; }
  .all:hover :global(svg) { transform: translateX(0.25rem); }

  .track { position: relative; container-type: inline-size; }
  /* The scroller spans the page; padding lines the first card up with the container (cqi: without scrollbar). */
  .scroller {
    --inset: max(24px, calc((100cqi - 1248px) / 2 + 24px));
    display: flex; gap: 20px; margin: 2.5rem 0 0; padding: 0 var(--inset); list-style: none; font-size: 1rem; line-height: 1.5; /* a row of cards, not running text */
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--inset); scrollbar-width: none; overscroll-behavior-x: contain;
  }
  .scroller::-webkit-scrollbar { display: none; }
  .scroller li { flex: 0 0 calc((min(100cqi, 1248px) - 48px) * 5 / 12); margin: 0; scroll-snap-align: start; }
  @media (min-width: 800px) { .scroller { gap: 40px; } .scroller li { flex-basis: calc((min(100cqi, 1248px) - 48px) * 0.22); } }
  .track::after { content: ''; position: absolute; top: 0; right: 0; z-index: 1; width: 25%; height: 100%; pointer-events: none; background: linear-gradient(to left, rgb(255 255 255 / 0.75), transparent); } /* hints at more cards */
  .nav { position: absolute; top: 50%; z-index: 2; width: 5rem; transform: translateY(-50%); opacity: 0; transition: opacity 0.2s; }
  .prev { left: 0; } .prev :global(svg) { transform: rotate(180deg); }
  .next { right: 0; }
  @media (min-width: 800px) and (hover: hover) { .track:hover .nav:not([disabled]) { opacity: 1; } }
  .nav[disabled] { pointer-events: none; }
</style>
